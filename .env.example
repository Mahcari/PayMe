# ── Stellar Network ────────────────────────────────────────────────────────────
# RPC endpoint for the target Stellar network.
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  https://soroban-mainnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase used to sign transactions.
# Testnet:  Test SDF Network ; September 2015
# Mainnet:  Public Global Stellar Network ; September 2015
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Shorthand alias recognised by the Stellar CLI (`stellar network use`).
STELLAR_NETWORK=testnet

# ── Deployer Account ───────────────────────────────────────────────────────────
# Bech32-encoded Stellar key pair used to deploy and upgrade contracts.
# Keep the secret key out of version control; commit only the public key here.
DEPLOYER_PUBLIC_KEY=GABC...
DEPLOYER_SECRET_KEY=SABC...

# ── Deployed Contract Addresses ───────────────────────────────────────────────
# Populated after first deployment; used by the server and client packages.
PAYME_ESCROW_CONTRACT_ID=

# ── Soroban Build ─────────────────────────────────────────────────────────────
# Cargo profile used when compiling WASM artifacts.
# Values: release | release-with-logs
CARGO_BUILD_PROFILE=release
